{
  "name": "@mambalabsdev/mcp-business-pdf-field-extractor",
  "version": "1.0.1",
  "description": "MCP server for Business PDF Field Extractor. Invoice, purchase order, and contract fields from PDFs, with line items and OCR for scans. No AI. Runs on Apify.",
  "type": "module",
  "bin": {
    "mcp-business-pdf-field-extractor": "./build/index.js"
  },
